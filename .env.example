# Copy to .env and fill in. .env is gitignored.
AZURE_SQL_SERVER=sql-shopstream-<initials>.database.windows.net
AZURE_SQL_DATABASE=sqldb-shopstream-oltp
# sql = SQL login below | entra-interactive = browser sign-in with your Entra account
AZURE_SQL_AUTH=sql
AZURE_SQL_USER=shopstreamadmin
AZURE_SQL_PASSWORD=
ODBC_DRIVER=ODBC Driver 18 for SQL Server
